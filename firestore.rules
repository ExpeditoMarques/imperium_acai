rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Os documentos e coleções não ficam acessíveis até serem definidas regras
    // específicas para cada recurso. Apenas administradores podem acessar
    // coleções protegidas por este padrão.
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      // O cliente não pode alterar privilégios administrativos pelo perfil.
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && !('admin' in request.resource.data);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Criação e mudança de pedidos permanecem bloqueadas até serem
      // implementadas regras de validação de pedido específicas.
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
